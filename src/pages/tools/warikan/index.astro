---
import Layout from "../../../layouts/Layout.astro";
import WarikanApp from "../../../components/warikan/WarikanApp";
import {
  BADGE_TEXT,
  SEO_DESCRIPTION,
  SEO_TITLE,
  SERVICE_NAME,
  SUPPLEMENT_TEXT,
  TAGLINE_LINE1,
  TAGLINE_LINE2,
} from "../../../lib/warikan/branding";

const title = SEO_TITLE;
const description = SEO_DESCRIPTION;

const faqs = [
  {
    q: "傾斜あり割り勘とは何ですか？",
    a: "全員が同じ金額を払う「均等割り」ではなく、学年・役職・運転の有無といった条件に応じて支払額に差をつける割り勘の方法です。このツールでは、条件ごとに「支払いグループ」を作り、グループごとの比率（傾斜）を自由に設定することで、複雑な傾斜計算をワンタップで行えます。",
  },
  {
    q: "大学生・サークルで学年ごとに割り勘するにはどうすればいいですか？",
    a: "「誰との割り勘？」から「大学生・サークル」を選ぶと、4年生・3年生・2年生・1年生のグループが初期設定されます。OB・OG・院生・6年生などは自由に追加でき、区分名や比率も自分たちのルールに合わせて変更できます。",
  },
  {
    q: "OB・OGが参加する飲み会の割り勘にも対応していますか？",
    a: "はい。「完全カスタム」から始めるか、既存のグループに「OB」「OG」などのグループを追加し、比率を設定するだけで反映できます。",
  },
  {
    q: "会社の飲み会で役職ごとに傾斜をつけられますか？",
    a: "「会社・職場」を選ぶと、部長・課長・係長・一般・新人といった役職グループを初期設定できます。社長・役員・アルバイト・社会人◯年目など、自由に名称と比率を変更・追加できます。",
  },
  {
    q: "運転してくれた人やお酒を飲んでいない人を安くできますか？",
    a: "参加者ごとの「個別調整」機能で、金額（例：-1,000円）または割合（例：-20%）を指定できます。理由には「運転してくれた」「車を出してくれた」「お酒を飲んでいない」などのプリセットが用意されており、結果の共有テキストにも自動で反映されます。",
  },
  {
    q: "途中参加・途中退出の人はどう計算すればいいですか？",
    a: "個別調整で「途中参加」「途中退出」の理由を選び、割合（例：-20%）または金額で減額を指定してください。他の参加者には、その分が元の傾斜比率を保ったまま自動で再配分されます。",
  },
  {
    q: "割り切れない金額や端数はどう処理されますか？",
    a: "1円・10円・100円・500円・1,000円単位から丸め方を選べます。端数の負担方法は「おまかせ（傾斜を考慮して自動調整）」「多く払う人が負担」「指定した人が負担」「みんなで調整」「端数として残す」の5種類から選択でき、参加者への配分合計は必ず会計金額と一致するように計算されます（数学的に一致できない場合は、その旨を画面に明示します）。",
  },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<Layout title={title} description={description} path="/tools/warikan/">
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} is:inline />

  <header class="border-b border-slate-200 bg-white">
    <div class="mx-auto max-w-md px-4 pt-4 pb-3.5 sm:max-w-lg">
      <h1 class="text-2xl font-extrabold tracking-tight text-slate-900">{SERVICE_NAME}</h1>
      <p class="mt-1 text-sm font-bold leading-snug text-slate-700">
        {TAGLINE_LINE1}<br />{TAGLINE_LINE2}
      </p>
      <p class="mt-1 text-xs leading-relaxed text-slate-500">{SUPPLEMENT_TEXT}</p>
      <span class="mt-2 inline-block rounded-full bg-teal-50 px-2.5 py-1 text-[11px] font-semibold text-teal-700">
        {BADGE_TEXT}
      </span>
    </div>
  </header>

  <main>
    <WarikanApp client:load />
  </main>

  <div class="mt-8 border-y border-slate-200 bg-slate-100 px-4 py-2 text-center text-xs font-semibold text-slate-400">
    ツールの使い方をもっと詳しく
  </div>

  <section class="mx-auto max-w-md px-4 py-10 sm:max-w-lg">
    <h2 class="text-base font-bold text-slate-800">傾斜あり割り勘とは？</h2>
    <p class="mt-2 text-sm leading-relaxed text-slate-600">
      飲み会や旅行の割り勘では、学年・役職・年次・運転の有無・お酒を飲む量など、人によって事情が異なることがよくあります。この割り勘計算ツールは、そうした事情を「支払いグループ」や「個別調整」として自由に設定し、合計金額を傾斜比率にもとづいて按分できる無料のWebツールです。ログイン不要・アプリのインストール不要で、スマートフォンからすぐに使えます。
    </p>

    <h3 class="mt-6 text-sm font-bold text-slate-800">大学生・サークルで学年ごとに割り勘する方法</h3>
    <p class="mt-2 text-sm leading-relaxed text-slate-600">
      「大学生・サークル」を選ぶと、4年生・3年生・2年生・1年生のグループが自動で用意されます。OB・OG・院生・留年・長期在籍などのケースも、グループを追加して比率を設定するだけで反映できます。
    </p>

    <h3 class="mt-6 text-sm font-bold text-slate-800">OB・OGが参加する飲み会の割り勘</h3>
    <p class="mt-2 text-sm leading-relaxed text-slate-600">
      現役生とOB・OGで支払額に差をつけたい場合も、グループを追加して比率を高めに設定するだけです。先輩・後輩の関係が複雑な場合でも、グループ数に制限はありません。
    </p>

    <h3 class="mt-6 text-sm font-bold text-slate-800">会社の飲み会で役職ごとに傾斜をつける方法</h3>
    <p class="mt-2 text-sm leading-relaxed text-slate-600">
      「会社・職場」を選ぶと、部長・課長・係長・一般・新人といった役職ごとのグループを初期設定できます。社会人◯年目やアルバイトなど、職場ごとのルールに合わせて自由にカスタマイズ可能です。
    </p>

    <h3 class="mt-6 text-sm font-bold text-slate-800">運転してくれた人を安くする方法</h3>
    <p class="mt-2 text-sm leading-relaxed text-slate-600">
      参加者ごとの個別調整で「運転してくれた」「車を出してくれた」を選び、金額または割合で減額できます。ドライブ・旅行の割り勘では、「運転した人」「車を出した人」グループも活用できます。
    </p>

    <h3 class="mt-6 text-sm font-bold text-slate-800">お酒を飲んでいない人を安くする場合</h3>
    <p class="mt-2 text-sm leading-relaxed text-slate-600">
      個別調整の理由から「お酒を飲んでいない」を選択し、金額または割合を指定してください。他の参加者には、その差額が元の傾斜比率を維持したまま自動で再配分されます。
    </p>

    <h3 class="mt-6 text-sm font-bold text-slate-800">途中参加・途中退出の割り勘</h3>
    <p class="mt-2 text-sm leading-relaxed text-slate-600">
      「途中参加」「途中退出」の理由と割合（例：-20%）を組み合わせることで、参加していた時間の目安に応じた金額に調整できます。
    </p>

    <h3 class="mt-6 text-sm font-bold text-slate-800">割り切れない金額・端数の処理方法</h3>
    <p class="mt-2 text-sm leading-relaxed text-slate-600">
      1円・10円・100円・500円・1,000円単位の丸めに対応しています。端数の負担方法は「おまかせ」「多く払う人が負担」「指定した人が負担」「みんなで調整」「端数として残す」から選べ、参加者への配分合計は必ず元の会計金額と一致するように計算されます。
    </p>

    <h2 class="mt-8 text-base font-bold text-slate-800">よくある質問</h2>
    <div class="mt-2 divide-y divide-slate-200">
      {faqs.map((f) => (
        <details class="group py-3">
          <summary class="cursor-pointer text-sm font-semibold text-slate-800 marker:content-none">
            {f.q}
          </summary>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">{f.a}</p>
        </details>
      ))}
    </div>
  </section>
</Layout>
