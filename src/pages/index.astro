---
import Layout from "../layouts/Layout.astro";
import { SERVICE_NAME } from "../lib/warikan/branding";

// 本番（Cloudflare Pages）ではpublic/_redirectsによりエッジで301リダイレクトされ、
// このページの内容が実際に配信されることはない。
// ローカルのdev/previewなど_redirectsが効かない環境向けのフォールバックとして、
// JSによる即時リダイレクト＋noscript時のmeta refreshを用意している。
const destination = "/tools/warikan/";
---

<Layout
  title={SERVICE_NAME}
  description={`${SERVICE_NAME}のページへ移動します。`}
  path="/tools/warikan/"
  noindex={true}
>
  <script define:vars={{ destination }} is:inline>
    window.location.replace(destination);
  </script>
  <noscript>
    <meta http-equiv="refresh" content={`0;url=${destination}`} />
  </noscript>
  <main class="flex min-h-screen items-center justify-center px-4 text-center">
    <p class="text-sm text-slate-500">
      <a href={destination} class="font-semibold text-teal-700 underline">{SERVICE_NAME}</a>
      へ移動しています…
    </p>
  </main>
</Layout>
